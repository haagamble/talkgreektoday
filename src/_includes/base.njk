<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title == 'Talk Greek Today' %}{{ title }}{% else %}{{ title }} · Talk Greek Today{% endif %}</title>
  <meta name="description" content="{{ description or summary or 'Practical Modern Greek lessons, examples, and exercises.' }}">
  <link rel="stylesheet" href="{{ '/assets/style.css' | urlpath }}">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><a class="brand" href="{{ '/' | urlpath }}"><span class="brand-icon" lang="el">ελ</span> Talk Greek Today<span class="brand-sub">MODERN GREEK LESSONS AND RESOURCES</span></a>
<nav aria-label="Main navigation"><a href="{{ '/beginner-course/' | urlpath }}" {% if page.url == '/beginner-course/' %}aria-current="page"{% endif %}>Beginner course</a><a href="{{ '/lessons/' | urlpath }}" {% if page.url == '/lessons/' %}aria-current="page"{% endif %}>Lessons</a><a href="{{ '/videos/' | urlpath }}" {% if page.url == '/videos/' %}aria-current="page"{% endif %}>Videos</a><a href="{{ '/audio/' | urlpath }}" {% if page.url == '/audio/' %}aria-current="page"{% endif %}>Audio</a><a href="{{ '/reading/' | urlpath }}" {% if page.url == '/reading/' %}aria-current="page"{% endif %}>Reading</a><a href="{{ '/about/' | urlpath }}">About</a><a class="search-link" href="{{ '/search/' | urlpath }}">Search <span aria-hidden="true">↗</span></a></nav></header>
<main id="main" {% if category %}data-pagefind-body{% endif %}>{{ content | safe }}</main>
<footer><a class="footer-brand" href="{{ '/' | urlpath }}">Talk Greek Today</a><a href="https://talktajiktoday.com/">Also learning Tajik? Visit Talk Tajik Today ↗</a></footer>
<script src="{{ '/assets/site.js' | urlpath }}" defer></script>
</body></html>
