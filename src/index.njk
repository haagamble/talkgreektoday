---
layout: base.njk
title: Talk Greek Today
---
<section class="hero wrap">
  <div>
    <h1>Modern Greek for everyday life.</h1>
    <p class="lede">Explore lessons, linked resources and interactive learning activities.</p>
    <a class="button" href="{{ '/beginner-course/' | urlpath }}">Start learning Greek <span>→</span></a>
    <a class="quiet-link" href="{{ '/lessons/' | urlpath }}">Browse all lessons ↗</a>
  </div>
</section>
<section class="learning-routes wrap" aria-label="Ways to learn">
  <a class="route" href="{{ '/beginner-course/' | urlpath }}"><p class="eyebrow">FOLLOW A PATH</p><h2>Beginner course <span aria-hidden="true">→</span></h2><p>Begin your Greek journey.</p></a>
  <a class="route" href="{{ '/lessons/' | urlpath }}"><p class="eyebrow">EXPLORE</p><h2>All lessons <span aria-hidden="true">→</span></h2><p>Browse grammar, topical, and reference lessons.</p></a>
</section>
<section class="lesson-section wrap" aria-labelledby="resources-heading">
  <div class="section-title"><h2 id="resources-heading">More ways to learn</h2></div>
  <div class="cards resource-cards">
    <a class="card" href="{{ '/videos/' | urlpath }}"><h3>Videos</h3><p>Watch Greek lessons and stories with subtitles.</p><span class="card-bottom">Explore videos <span aria-hidden="true">↗</span></span></a>
    <a class="card" href="{{ '/audio/' | urlpath }}"><h3>Audio</h3><p>Learn by listening with a free Greek audio course.</p><span class="card-bottom">Explore audio <span aria-hidden="true">↗</span></span></a>
    <a class="card" href="{{ '/reading/' | urlpath }}"><h3>Reading</h3><p>Explore stories, articles, and other texts in Modern Greek.</p><span class="card-bottom">Explore reading <span aria-hidden="true">↗</span></span></a>
    <a class="card" href="{{ '/interactive/' | urlpath }}"><h3>Interactive</h3><p>Build your Greek vocabulary with interactive activities.</p><span class="card-bottom">Explore activities <span aria-hidden="true">↗</span></span></a>
  </div>
</section>
<section class="lesson-section wrap">
  <div class="section-title"><h2>A few places to explore</h2></div>
  <div class="cards">
    {% for lesson in collections.featuredLessons %}
    <a class="card" href="{{ lesson.url | urlpath }}"><div class="card-top"><span>{{ lesson.data.category }}</span></div><h3>{{ lesson.data.title }}</h3><p>{{ lesson.data.summary }}</p><span class="card-bottom">Read & practise <span>↗</span></span></a>
    {% endfor %}
  </div>
</section>
